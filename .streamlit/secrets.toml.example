# Copy this file to .streamlit/secrets.toml (it is git-ignored, never commit it) or paste the same lines into
# Streamlit Community Cloud -> App settings -> Secrets.

# Licensing: created by tools/make_activation_code.py. Without these, the app runs in open demo mode.
ACTIVATION_SECRET = "..."          # keys the activation-code hashes; keep private, same value locally and online

OPENAI_API_KEY = "sk-..."          # AI Assistant: tried first
GEMINI_API_KEY = ""                # AI Assistant: free fallback when OpenAI fails (https://aistudio.google.com/apikey)
CONSULT_BOOKING_URL = ""           # Book a consultation: your Calendly / Cal.com event link (empty = "not connected yet")

# Optional
# OPENAI_MODEL = "gpt-5-mini"      # must accept images; if unset, the app picks the first available of
                                   # gpt-5-mini, gpt-5, gpt-4.1-mini, gpt-4.1, gpt-4o-mini, gpt-4o
# GEMINI_MODEL = "gemini-2.5-flash"  # if unset, the newest stable Gemini Flash model is picked
# MEDVISION_BACKEND = "phikon"     # colorectal classifier backend (see medvision/classifier/registry.py)
# HF_TOKEN = ""                    # only to raise Hugging Face download rate limits

# One table per customer licence (printed by tools/make_activation_code.py). Tables must come after all plain keys.
# [activation_codes.acme-hospital]
# hash = "3f1c..."
# organisation = "Acme Hospital, Pathology"
# plan = "Research"
# expires = "2027-10-31"
# active = true

# Optional real specialists for "Book a consultation" (otherwise example profiles are shown).
# [specialists.gi-pathology]
# name = "Dr. A. Example"
# title = "Consultant gastrointestinal pathologist"
# focus = "Colorectal tumours, polyps, second opinions"
# languages = "English, French"
# duration = "30 min · video call"
# booking_url = "https://calendly.com/dr-example/30min"
