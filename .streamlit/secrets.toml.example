# Copy this file to .streamlit/secrets.toml (it is git-ignored, never commit it) or paste the same lines into
# Streamlit Community Cloud -> App settings -> Secrets.

OPENAI_API_KEY = "sk-..."          # AI Assistant: tried first
GEMINI_API_KEY = ""                # AI Assistant: free fallback when OpenAI fails (https://aistudio.google.com/apikey)

# Optional
# OPENAI_MODEL = "gpt-5-mini"      # must accept images; if unset, the app picks the first available of
                                   # gpt-5-mini, gpt-5, gpt-4.1-mini, gpt-4.1, gpt-4o-mini, gpt-4o
# GEMINI_MODEL = "gemini-2.5-flash"  # if unset, the newest stable Gemini Flash model is picked
# MEDVISION_BACKEND = "phikon"     # colorectal classifier backend (see medvision/classifier/registry.py)
# HF_TOKEN = ""                    # only to raise Hugging Face download rate limits
